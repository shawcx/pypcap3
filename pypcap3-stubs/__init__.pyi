"""Type stubs for pypcap3, the libpcap bindings.

test/test_pypcap3.py::test_stubs_match_module checks that these names match
the compiled module, so update both together.
"""

import sys
from collections.abc import Callable, Iterable, Iterator, Sequence
from os import PathLike
from types import GenericAlias
from typing import Any, Generic, Literal, Protocol, TypedDict, TypeVar, overload

from typing_extensions import Buffer, NotRequired, disjoint_base, final

_T = TypeVar("_T")

class _HasFileno(Protocol):
    def fileno(self) -> int: ...

# a path, a file object or a file descriptor
_File = str | bytes | PathLike[str] | PathLike[bytes] | int | _HasFileno

# (packet, ts, orig_len), from header=True
_Header = tuple[bytes, float, int]

# (dlt, name, description), and the same for timestamp types
_TypeInfo = tuple[int, str | None, str | None]

class _Address(TypedDict):
    family: int
    addr: str
    netmask: str | None
    broadcast: str | None
    dstaddr: str | None

class _Device(TypedDict):
    description: str | None
    flags: int
    addresses: list[_Address]
    # from the device's last IPv4 address, when it has one
    ip: NotRequired[str]
    netmask: NotRequired[str]
    broadcast: NotRequired[str]

class error(Exception): ...

D_IN: int
D_OUT: int
D_INOUT: int

IF_LOOPBACK: int
IF_UP: int
IF_RUNNING: int
IF_WIRELESS: int
IF_CONNECTION_STATUS: int
IF_CONNECTION_STATUS_UNKNOWN: int
IF_CONNECTION_STATUS_CONNECTED: int
IF_CONNECTION_STATUS_DISCONNECTED: int
IF_CONNECTION_STATUS_NOT_APPLICABLE: int

TSTAMP_PRECISION_MICRO: int
TSTAMP_PRECISION_NANO: int
TSTAMP_HOST: int
TSTAMP_HOST_LOWPREC: int
TSTAMP_HOST_HIPREC: int
TSTAMP_HOST_HIPREC_UNSYNCED: int
TSTAMP_ADAPTER: int
TSTAMP_ADAPTER_UNSYNCED: int

if sys.platform == "win32":
    MODE_CAPT: int
    MODE_STAT: int
    SRC_FILE: int
    SRC_IFLOCAL: int
    SRC_IFREMOTE: int
    OPENFLAG_PROMISCUOUS: int
    OPENFLAG_DATATX_UDP: int
    OPENFLAG_NOCAPTURE_RPCAP: int
    OPENFLAG_NOCAPTURE_LOCAL: int
    OPENFLAG_MAX_RESPONSIVENESS: int
    SAMP_NOSAMP: int
    SAMP_1_EVERY_N: int
    SAMP_FIRST_AFTER_N_MS: int

def version() -> str: ...
def find() -> dict[str, _Device]: ...
def mac(iface: str, /) -> bytes | None: ...
def lookupnet(iface: str, /) -> tuple[str, str]: ...
def open_live(device: str, snaplen: int = 65535, promisc: int = 1, to_ms: int = 100, /) -> handle: ...
def open_file(file: _File, precision: int = ...) -> handle: ...
def open_offline(file: _File, precision: int = ...) -> handle: ...
def create(device: str, /) -> handle: ...
def open_dead(linktype: int = 1, snaplen: int = 65535, precision: int = ...) -> handle: ...
def compile(
    expression: str, linktype: int = 1, snaplen: int = 65535, optimize: bool = True, netmask: str | None = None
) -> bpf_program: ...
def datalink_name_to_val(name: str, /) -> int: ...
def datalink_val_to_name(value: int, /) -> str | None: ...
def datalink_val_to_description(value: int, /) -> str | None: ...
def tstamp_type_name_to_val(name: str, /) -> int: ...
def tstamp_type_val_to_name(value: int, /) -> str | None: ...

if sys.platform == "win32":
    def open_remote(
        source: str,
        snaplen: int = 65535,
        flags: int = 0,
        read_timeout: int = 100,
        username: str | None = None,
        password: str | None = None,
    ) -> handle: ...
    def find_remote(source: str, username: str | None = None, password: str | None = None) -> dict[str, _Device]: ...
    def createsrcstr(type: int, host: str | None = None, port: str | None = None, name: str | None = None) -> str: ...
    def parsesrcstr(source: str, /) -> tuple[int, str | None, str | None, str | None]: ...
    def remoteact_accept(
        address: str | None = None,
        port: str | None = None,
        hostlist: str | None = None,
        username: str | None = None,
        password: str | None = None,
        ssl: bool = False,
    ) -> str: ...
    def remoteact_list() -> list[str]: ...
    def remoteact_close(host: str, /) -> None: ...
    def remoteact_cleanup() -> None: ...

@disjoint_base
class handle:
    # a handle made directly has no device; use open_live() and the like
    def __init__(self) -> None: ...
    def activate(self) -> str | None: ...
    def close(self) -> None: ...
    def snapshot(self) -> int: ...
    def bufsize(self) -> int: ...
    def stats(self) -> tuple[int, int, int]: ...
    def geterr(self) -> str: ...
    def datalink(self) -> _TypeInfo: ...
    def list_datalinks(self) -> list[_TypeInfo]: ...
    def set_datalink(self, dlt: int, /) -> None: ...
    def major_version(self) -> int: ...
    def minor_version(self) -> int: ...
    def is_swapped(self) -> bool: ...

    # before activate(); a warning comes back as text
    def set_snaplen(self, snaplen: int, /) -> str | None: ...
    def set_promisc(self, promisc: int, /) -> str | None: ...
    def set_timeout(self, ms: int, /) -> str | None: ...
    def set_immediate_mode(self, immediate: int, /) -> str | None: ...
    def set_buffer_size(self, size: int, /) -> str | None: ...
    def set_rfmon(self, rfmon: int, /) -> str | None: ...
    def can_set_rfmon(self) -> bool: ...
    def set_tstamp_type(self, tstamp_type: int, /) -> str | None: ...
    def list_tstamp_types(self) -> list[_TypeInfo]: ...
    def set_tstamp_precision(self, precision: int, /) -> str | None: ...
    def get_tstamp_precision(self) -> int: ...
    if sys.platform == "linux":
        def set_protocol_linux(self, protocol: int, /) -> str | None: ...

    def setnonblock(self, nonblock: int, /) -> None: ...
    def getnonblock(self) -> int: ...
    def setdirection(self, direction: int, /) -> bool: ...
    def setfilter(self, filter: str | bpf_program, optimize: bool = True, netmask: str | None = None) -> None: ...
    def compile(self, expression: str, optimize: bool = True, netmask: str | None = None) -> bpf_program: ...

    @overload
    def next(self, *, header: Literal[False] = False) -> bytes | None: ...
    @overload
    def next(self, *, header: Literal[True]) -> _Header | None: ...
    @overload
    def loop(self, callback: Callable[[bytes], object] | dumper, cnt: int = -1, *, header: Literal[False] = False) -> None: ...
    @overload
    def loop(self, callback: Callable[[bytes, float, int], object], cnt: int = -1, *, header: Literal[True]) -> None: ...
    @overload
    def dispatch(self, callback: Callable[[bytes], object] | dumper, cnt: int = -1, *, header: Literal[False] = False) -> int: ...
    @overload
    def dispatch(self, callback: Callable[[bytes, float, int], object], cnt: int = -1, *, header: Literal[True]) -> int: ...
    def breakloop(self) -> None: ...
    @overload
    def packets(self, *, header: Literal[False] = False) -> packet_iterator[bytes]: ...
    @overload
    def packets(self, *, header: Literal[True]) -> packet_iterator[_Header]: ...
    def __iter__(self) -> packet_iterator[bytes]: ...
    def __enter__(self) -> handle: ...
    def __exit__(self, *args: object) -> None: ...

    def fileno(self) -> int: ...
    if sys.platform != "win32":
        def get_selectable_fd(self) -> int: ...
        def get_required_select_timeout(self) -> float | None: ...

    def inject(self, packet: bytes, /) -> int: ...
    def dump_open(self, file: _File, append: bool = False) -> dumper: ...

    if sys.platform == "win32":
        def getevent(self) -> int: ...
        def setbuff(self, size: int, /) -> str | None: ...
        def setmintocopy(self, size: int, /) -> str | None: ...
        def setuserbuffer(self, size: int, /) -> str | None: ...
        def setmode(self, mode: int, /) -> str | None: ...
        def stats_ex(self) -> dict[str, int]: ...
        def oid_get_request(self, oid: int, size: int, /) -> bytes: ...
        def oid_set_request(self, oid: int, data: Buffer, /) -> None: ...
        def sendqueue_transmit(self, queue: sendqueue, sync: bool = False) -> int: ...
        def setsampling(self, method: int, value: int, /) -> None: ...

# (code, jt, jf, k), as tcpdump -ddd prints it
_Instruction = tuple[int, int, int, int]

@final
class bpf_program:
    # from compile(), or from instructions such as list(program)
    def __new__(cls, instructions: Iterable[Sequence[int]]) -> bpf_program: ...
    def match(self, packet: Buffer, /) -> bool: ...
    def instructions(self) -> list[str]: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int, /) -> _Instruction: ...
    def __iter__(self) -> Iterator[_Instruction]: ...

@final
class dumper:
    def write(self, packet: Buffer, ts: float | None = None, orig_len: int | None = None) -> None: ...
    def flush(self) -> None: ...
    def tell(self) -> int: ...
    def close(self) -> None: ...
    def __enter__(self) -> dumper: ...
    def __exit__(self, *args: object) -> None: ...

@final
class packet_iterator(Generic[_T]):
    def __iter__(self) -> packet_iterator[_T]: ...
    def __next__(self) -> _T: ...
    def __class_getitem__(cls, item: Any, /) -> GenericAlias: ...

if sys.platform == "win32":
    @final
    class sendqueue:
        def __init__(self, memsize: int) -> None: ...
        @property
        def size(self) -> int: ...
        @property
        def used(self) -> int: ...
        def queue(self, packet: Buffer, ts: float | None = None, orig_len: int | None = None) -> None: ...
